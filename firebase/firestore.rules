rules_version = '2';

/**
 * MentorBridge Firestore Security Rules
 * Comprehensive security rules for the mentorship platform
 * Version: 2.0 - Enhanced for production Firebase integration
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================================================================
    // AUTHENTICATION AND AUTHORIZATION HELPER FUNCTIONS
    // ================================================================
    
    /**
     * Check if user is authenticated
     */
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    /**
     * Check if user owns a resource
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * Get user profile data
     */
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    /**
     * Get current user's profile data
     */
    function getCurrentUserData() {
      return getUserData(request.auth.uid);
    }
    
    /**
     * Check if current user has specific role
     */
    function hasRole(role) {
      return isSignedIn() && getCurrentUserData().role == role;
    }
    
    /**
     * Check if current user is admin
     */
    function isAdmin() {
      return hasRole('admin');
    }
    
    /**
     * Check if current user is mentor
     */
    function isMentor() {
      return hasRole('mentor');
    }
    
    /**
     * Check if current user is student
     */
    function isStudent() {
      return hasRole('student');
    }
    
    /**
     * Check if user account is active
     */
    function isActiveUser() {
      return isSignedIn() && getCurrentUserData().accountStatus == 'active';
    }
    
    /**
     * Check if email is verified
     */
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    /**
     * Validate user profile data on creation/update
     */
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'name']) &&
             data.role in ['student', 'mentor', 'admin'] &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.name is string &&
             data.name.size() >= 2;
    }

    // ================================================================
    // USER PROFILES AND AUTHENTICATION
    // ================================================================
    
    match /users/{userId} {
      // Allow reading own profile or any profile for signed-in users
      allow read: if isSignedIn() && (isOwner(userId) || isActiveUser());
      
      // Allow creating own profile during registration
      allow create: if isSignedIn() && 
                      isOwner(userId) && 
                      isEmailVerified() &&
                      isValidUserProfile(request.resource.data);
      
      // Allow updating own profile or admin override
      allow update: if (isOwner(userId) && isActiveUser() && isEmailVerified()) || isAdmin();
      
      // Only admins can delete profiles
      allow delete: if isAdmin();
    }

    // ================================================================
    // MESSAGING SYSTEM
    // ================================================================
    
    match /conversations/{conversationId} {
      // Allow access if user is a participant in the conversation
      allow read, write: if isSignedIn() && 
                           isActiveUser() &&
                           request.auth.uid in resource.data.participants;
      
      // Allow creating conversations where user is a participant
      allow create: if isSignedIn() && 
                      isActiveUser() &&
                      request.auth.uid in request.resource.data.participants;
    }
    
    match /messages/{messageId} {
      // Allow reading messages in conversations user participates in
      allow read: if isSignedIn() && 
                    isActiveUser() &&
                    (request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants);
      
      // Allow sending messages (creating) in conversations user participates in
      allow create: if isSignedIn() && 
                      isActiveUser() &&
                      request.resource.data.senderId == request.auth.uid &&
                      (request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants);
      
      // Allow updating own messages (for read status, etc.)
      allow update: if isSignedIn() && 
                      isActiveUser() &&
                      (resource.data.senderId == request.auth.uid ||
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants);
      
      // Only admins or message sender can delete
      allow delete: if isAdmin() || 
                      (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    // ================================================================
    // SESSION MANAGEMENT
    // ================================================================
    
    match /sessions/{sessionId} {
      // Allow reading sessions user is involved in
      allow read: if isSignedIn() && 
                    isActiveUser() &&
                    (request.auth.uid == resource.data.mentorId || 
                     request.auth.uid == resource.data.studentId ||
                     isAdmin());
      
      // Students can create session requests
      allow create: if isSignedIn() && 
                      isActiveUser() &&
                      isStudent() &&
                      request.resource.data.studentId == request.auth.uid;
      
      // Mentors can update their sessions, students can update their requests
      allow update: if isSignedIn() && 
                      isActiveUser() &&
                      ((isMentor() && request.auth.uid == resource.data.mentorId) ||
                       (isStudent() && request.auth.uid == resource.data.studentId) ||
                       isAdmin());
      
      // Only admins can delete sessions
      allow delete: if isAdmin();
    }

    // ================================================================
    // NOTIFICATIONS SYSTEM
    // ================================================================
    
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && 
                    isActiveUser() &&
                    resource.data.userId == request.auth.uid;
      
      // System can create notifications (handled by Cloud Functions)
      // Users cannot create notifications directly
      allow create: if false;
      
      // Users can update their own notifications (mark as read, etc.)
      allow update: if isSignedIn() && 
                      isActiveUser() &&
                      resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications, admins can delete any
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || 
                      isAdmin();
    }

    // ================================================================
    // MENTOR DIRECTORY AND MATCHING
    // ================================================================
    
    match /mentorProfiles/{mentorId} {
      // Public read access for mentor discovery
      allow read: if isSignedIn() && isActiveUser();
      
      // Mentors can create/update their own profiles
      allow create, update: if isSignedIn() && 
                              isActiveUser() &&
                              isMentor() &&
                              request.auth.uid == mentorId;
      
      // Only admins can delete mentor profiles
      allow delete: if isAdmin();
    }
    
    match /matchingData/{userId} {
      // Users can read their own matching data
      allow read: if isSignedIn() && isActiveUser() && isOwner(userId);
      
      // Users can update their own matching preferences
      allow create, update: if isSignedIn() && 
                              isActiveUser() && 
                              isOwner(userId);
      
      // Only admins can delete matching data
      allow delete: if isAdmin();
    }

    // ================================================================
    // RESOURCES AND CONTENT
    // ================================================================
    
    match /resources/{resourceId} {
      // Public read access for all signed-in users
      allow read: if isSignedIn() && isActiveUser();
      
      // Only admins can manage resources
      allow create, update, delete: if isAdmin();
    }

    // ================================================================
    // ANALYTICS AND ADMIN
    // ================================================================
    
    match /analytics/{document=**} {
      // Only admins can access analytics
      allow read, write: if isAdmin();
    }
    
    match /systemLogs/{logId} {
      // Only admins can access system logs
      allow read, write: if isAdmin();
    }

    // ================================================================
    // CONNECTIVITY AND HEALTH CHECKS
    // ================================================================
    
    match /_health/{document=**} {
      // Allow health checks for system monitoring
      allow read: if isSignedIn();
    }
    
    match /_connectivity_test/{document=**} {
      // Deny all access to connectivity test collections
      allow read, write: if false;
    }

    // ================================================================
    // FALLBACK RULES
    // ================================================================
    
    // Deny access to any other collections not explicitly defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
